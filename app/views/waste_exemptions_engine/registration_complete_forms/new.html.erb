<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <% if @registration_complete_form.errors.any? %>

      <h1 class="govuk-heading-l"><%= t(".error_heading") %></h1>

      <% @registration_complete_form.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>

    <% else %>

      <div class="govuk-panel govuk-panel--confirmation">
        <h1 class="govuk-panel__title">
          <%= t(".heading") %>
          <br />
          <span class="govuk-panel__body"><%= t(".highlight_text") %></span>
        </h1>
        <div class="govuk-panel__body">
          <strong>
            <span id="reg_identifier"><%= @registration.reference %></span>
          </strong>
        </div>
      </div>

      <h2 class="govuk-heading-m"><%= t(".subheading") %></h2>

      <p class="govuk-body"><%= t(".confirmation_text.#{confirmation_comms(@registration_complete_form)}", contact: @registration_complete_form.contact_email) %></p>

      <p class="govuk-body"><%= t(".paragraph_1") %></p>

      <% if WasteExemptionsEngine::FeatureToggle.active?(:enable_reg_reform_content) %>
        <h2 class="govuk-heading-m"><%= t(".reg_reform.heading") %></h2>

        <p class="govuk-body"><%= t(".reg_reform.paragraph") %></p>

        <p class="govuk-body">
          <%= t(".reg_reform.read_more_html",
                link: link_to(t("waste_exemptions_engine.shared.reg_reform.link_text"),
                              reg_reform_link_url,
                              target: "_blank",
                              rel: "noopener noreferrer")) %>
        </p>
      <% end %>

      <p class="govuk-body"><%= link_to(t(".survey_link_text"), t("layouts.application.feedback_url"), target: "_blank") %> <%= t(".survey_link_hint") %></p>
    <% end %>
  </div>
</div>
